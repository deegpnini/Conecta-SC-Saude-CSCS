# CSCS - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com valores seguros
# NUNCA commite o .env com segredos reais!

# Autenticação (obrigatório - gere valores únicos)
JWT_SECRET=                        # gere com: openssl rand -hex 32
ADMIN_PASSWORD=                    # gere com: openssl rand -base64 15 | tr -d '/+=' | head -c 20

# Opcionais
ADMIN_USERNAME=admin
JWT_EXPIRATION=86400

# Banco de Dados
DATABASE_PATH=./conecta_saude.db

# Ambiente
ENV=development
